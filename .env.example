# Banco de dados PostgreSQL
# O Prisma exige as duas variáveis abaixo (DATABASE_URL e DIRECT_URL), mesmo
# que sejam iguais. DATABASE_URL é usada pela aplicação em runtime;
# DIRECT_URL é usada apenas para rodar as migrations.
#
# Uso local / Postgres simples (sem pooler): use o mesmo valor nas duas.
DATABASE_URL="postgresql://user:password@localhost:5432/sweetsecrets?schema=public"
DIRECT_URL="postgresql://user:password@localhost:5432/sweetsecrets?schema=public"

# Ao usar Supabase (ou outro Postgres atrás de um connection pooler / pgbouncer),
# use valores diferentes: DATABASE_URL aponta para o pooler (modo Transaction,
# porta 6543) e DIRECT_URL para o modo Session (porta 5432, mesmo host do
# pooler) — veja a seção "Usando Supabase" no README. Exemplo:
# DATABASE_URL="postgresql://postgres.<ref>:<senha>@aws-0-<regiao>.pooler.supabase.com:6543/postgres?pgbouncer=true"
# DIRECT_URL="postgresql://postgres.<ref>:<senha>@aws-0-<regiao>.pooler.supabase.com:5432/postgres"

# NextAuth — gere um valor aleatório com: openssl rand -base64 32
AUTH_SECRET=""

# Envio de e-mails (Resend) — necessário para o resumo semanal de eventos
RESEND_API_KEY=""
EMAIL_FROM="Sweet Secrets <avisos@seudominio.com>"

# Chave secreta para proteger o endpoint de cron do resumo semanal
CRON_SECRET=""

# URL pública da aplicação (usada em links de e-mail)
NEXT_PUBLIC_APP_URL="http://localhost:3000"
